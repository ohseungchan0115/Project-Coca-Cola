<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cocacola.mvc.mapper.OpenerPostDetailMapper">

    <select id="selectByPostId"
            parameterType="int"
            resultType="cocacola.mvc.domain.DetailDTO">
        SELECT
            DETAIL_ID,
            POST_ID,
            BLOCK_TYPE,
            TITLE,
            CONTENT,
            IMAGE_URL,
            DISPLAY_ORDER
        FROM OPENER_POST_DETAIL
        WHERE POST_ID = #{postId}
        ORDER BY DISPLAY_ORDER
    </select>

</mapper>
