package cocacola.mvc.persistence;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.BeanPropertyRowMapper;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import cocacola.mvc.domain.BrandDTO;
import cocacola.mvc.domain.BrandVideoDTO;
import cocacola.mvc.domain.ProductDTO;
import cocacola.mvc.domain.SubBrandDTO;

@Repository
public class BrandDAO {

    @Autowired
    private JdbcTemplate jdbcTemplate;

    /**
     * 브랜드 전체 목록 조회 (BrandHandler 및 OurCompanyHandler에서 공통 사용)
     */
    public List<BrandDTO> selectBrandList() throws Exception {
        // SQL 작성 시 DTO 필드명과 일치하도록 Alias(as)를 설정합니다.
        String sql = "SELECT b.brand_id as brandId, " +
                     "       b.brand_name as brandName, " +
                     "       b.brand_logo_url as brandLogoUrl, " +
                     "       NVL(LISTAGG(LOWER(c.brand_category_name), ',') " +
                     "           WITHIN GROUP (ORDER BY c.brand_category_name), '') AS brandCategories " +
                     "FROM Brands b " +
                     "LEFT JOIN Brand_Category bc ON b.brand_id = bc.brand_id " +
                     "LEFT JOIN Category c ON bc.brand_category_id = c.brand_category_id " +
                     "GROUP BY b.brand_id, b.brand_name, b.brand_logo_url " +
                     "ORDER BY b.brand_id";

        return jdbcTemplate.query(sql, new BeanPropertyRowMapper<>(BrandDTO.class));
    }

    // 브랜드 상세 정보 조회
    public BrandDTO selectBrand(int brandId) {
        String sql = "SELECT brand_id as brandId, brand_name as brandName, brand_logo_url as brandLogoUrl, " +
                     "brand_description as brandDescription, brand_origin as brandOrigin, brand_mainphoto_url as brandMainphotoUrl " +
                     "FROM Brands WHERE brand_id = ?";
        try {
            return jdbcTemplate.queryForObject(sql, new Object[]{brandId}, new BeanPropertyRowMapper<>(BrandDTO.class));
        } catch (Exception e) {
            return null;
        }
    }

    // [추가] 브랜드 영상 정보 조회 (이 부분이 없어서 오류가 났던 것입니다)
    public BrandVideoDTO selectBrandVideo(int brandId) {
        String sql = "SELECT brand_id as brandId, youtube_video_id as youtubeVideoId, " +
                     "video_thumbnail_url as videoThumbnailUrl, video_description as videoDescription " +
                     "FROM Brand_Video WHERE brand_id = ?";
        try {
            return jdbcTemplate.queryForObject(sql, new Object[]{brandId}, new BeanPropertyRowMapper<>(BrandVideoDTO.class));
        } catch (Exception e) {
            return null; // 영상 정보가 없을 경우 null 반환
        }
    }

    // 브랜드별 제품 목록 조회
    public List<ProductDTO> selectProducts(int brandId) {
        String sql = "SELECT product_id as productId, brand_id as brandId, sub_brand_id as subBrandId, " +
                     "product_name as productName, product_volume as productVolume, " +
                     "product_image_url as productImageUrl, product_description as productDescription " +
                     "FROM Product WHERE brand_id = ?";
        return jdbcTemplate.query(sql, new Object[]{brandId}, new BeanPropertyRowMapper<>(ProductDTO.class));
    }

    // 서브 브랜드 목록 조회
    public List<SubBrandDTO> selectSubBrands(int brandId) {
        String sql = "SELECT sub_brand_id as subBrandId, brand_id as brandId, " +
                     "sub_brand_name as subBrandName, sub_brand_logo_url as subBrandLogoUrl FROM SubBrand WHERE brand_id = ?";
        return jdbcTemplate.query(sql, new Object[]{brandId}, new BeanPropertyRowMapper<>(SubBrandDTO.class));
    }
}