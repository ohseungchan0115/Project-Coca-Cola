package cocacola.mvc.command;

import java.util.List;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import cocacola.mvc.domain.BrandDTO;
import cocacola.mvc.domain.ProductDTO;
import cocacola.mvc.persistence.BrandDAO;

public class MinuteMadeProductHandler implements CommandHandler {

    @Override
    public String process(HttpServletRequest req, HttpServletResponse resp)
            throws Exception {

        String startParam = req.getParameter("start");
        String endParam = req.getParameter("end");

        int start = startParam != null ? Integer.parseInt(startParam) : 0;
        int end = endParam != null ? Integer.parseInt(endParam) : 9999;

        BrandDAO dao = new BrandDAO();

        // 미닛메이드 브랜드 ID
        int brandId = 9;

        BrandDTO brand = dao.selectBrand(brandId);
        List<ProductDTO> products = dao.selectProducts(brandId);

        brand.setProducts(products);

        req.setAttribute("brand", brand);
        req.setAttribute("start", start);
        req.setAttribute("end", end);

        return "/WEB-INF/views/cocacola/brands/minutemaidProduct.jsp";
    }
}
