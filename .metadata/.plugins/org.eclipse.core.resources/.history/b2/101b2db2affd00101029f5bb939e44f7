<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Coke & Meal | 코카-콜라 - Real Magic | 한국 코카-콜라</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/cocacola/css/Coke_Meal.css">
</head>

<body>
<%@ include file="../nav.jsp" %>
	<div class="logo">
		<img alt="" src="${pageContext.request.contextPath}/cocacola/coke_meal/kr_coca_cola_logo_500x180.png">
	</div>

<div class="top-tab">
  <a href="${pageContext.request.contextPath}/brandDetail.do?brandId=1&tab=home"
     class="tab ${param.tab == null || param.tab == 'home' ? 'active' : ''}">
     홈
  </a>

  <a href="${pageContext.request.contextPath}/brandDetail.do?brandId=1&tab=products"
     class="tab ${param.tab == 'products' ? 'active' : ''}">
     제품 정보
  </a>
</div>

	<div class="mainphoto">
		<img alt="" src="${pageContext.request.contextPath}/cocacola/coke_meal/coke_meal_banner.png" class="mphoto">
	</div>
	
	<c:forEach var="cokemeal" items="${cardStories1}" varStatus="status">
    <%-- 짝수번째는 reverse 클래스를 추가하여 좌우 반전 --%>
    <div class="overlap-row ${status.index % 2 == 0 ? 'reverse' : ''}">
        <div class="card image-card">
            <img src="${pageContext.request.contextPath}/cocacola/coke_meal/${cokemeal.image}" class="mphoto">
        </div>

        <div class="card text-card">
            <h3 class="title">${cokemeal.title}</h3>
            <p class="desc">${cokemeal.summary}</p>
            <button class="outline-btn">자세히 알아보기</button>
        </div>
    </div>
</c:forEach>

	<div class="guide-section">
	<c:forEach var="cokemeal" items="${guide}">
		<div class="guide-card">
			<img src="${pageContext.request.contextPath}/cocacola/coke_meal/${cokemeal.image}" alt="">
			<div class="guide-text">
				<h3>${cokemeal.title}</h3>
				<a href="#" class="guide-link">자세히 보기 </a>
				<span>→</span>
			</div>
		</div>
		</c:forEach>
	</div>



	<h2 class="section-title">
		새로운 맛집의 상징, <br> 코카-콜라 레드리본 맛집
	</h2>
	<p class="section-subtitle">코카-콜라와 블루리본 서베이가 함께 선보이는 짜릿한 미식 생활에
		여러분을 초대합니다.</p>

	<div class="overlap-row">
		<div class="card text-card">
			<h3 class="title">
				레드리본 맛집 <br> 어떻게 선정되나요?
			</h3>
			<p class="desc">
				1. 코카-콜라의 짜릿함과 잘 어울리는 음식을 맛볼 수 있는 곳 <br>
				<br> 2. 맛있는 음식으로 고객들의 긍정적인 리뷰와 평가가 많은 곳 <br>
				<br> 3. 편안하고 즐거운 분위기로 행복한 미식 경험을 제공하는 곳
			</p>

		</div>

		<div class="card image-card coca-red">
			<img alt="" src="${pageContext.request.contextPath}/cocacola/coke_meal/campaign-card.png" class="mphoto">
		</div>
	</div>



	<c:forEach var="cokemeal" items="${cardStories2}" varStatus="status">
    <%-- 짝수번째는 reverse 클래스를 추가하여 좌우 반전 --%>
    <div class="overlap-row ${status.index % 2 == 0 ? 'reverse' : ''}">
        <div class="card image-card">
            <img src="${pageContext.request.contextPath}/cocacola/coke_meal/${cokemeal.image}" class="mphoto">
        </div>

        <div class="card text-card">
            <h3 class="title">${cokemeal.title}</h3>
            <p class="desc">${cokemeal.summary}</p>
            <%-- 버튼 텍스트 조건부 렌더링 --%>
            <c:choose>
                <c:when test="${status.last}">
                    <%-- 마지막 카드일 때 --%>
                    <button class="outline-btn">네이버/카카오 맵에서 확인하기</button>
                </c:when>
                <c:otherwise>
                    <%-- 마지막 카드가 아닐 때 (나머지) --%>
                    <button class="outline-btn">자세히 알아보기</button>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</c:forEach>


	<h4 class="section-subtitle2">에디터가 간다! 레드리본 맛집 순례</h4>

	<c:forEach var="cokemeal" items="${cardStories2_1}" varStatus="status">
    <div class="overlap-row reverse">
		<div class="card image-card photo">
			<img alt=""
				src="${pageContext.request.contextPath}/cocacola/coke_meal/${cokemeal.image}"
				class="mphoto">
		</div>

		<div class="card text-card">
			<h3 class="title">${cokemeal.title}</h3>
			<p class="desc">${cokemeal.summary}</p>
			<button class="outline-btn">자세히 알아보기</button>
		</div>
	</div>
</c:forEach>

	<div class="restaurant-grid">
	<c:forEach var="cokemeal" items="${another}" varStatus="status">
		<a href="${pageContext.request.contextPath}/coke_meal.do?id=${cokemeal.id}" class="restaurant-card">
   
			<div class="res-img-wrapper">
				<img src="${pageContext.request.contextPath}/cocacola/coke_meal/${cokemeal.image}" class="ribbon-badge">
			</div>
			<div class="res-info">
				<span>${cokemeal.title}</span>
				<p>→</p>
			</div>
		</a> 
		</c:forEach>
	</div>

	<p class="p-section">- 레드리본 맛집 업데이트는 계속됩니다 -</p>

	<div class="coke-banner">
		<div class="banner-text">다양한 곳에서 코카-콜라를 만나보세요</div>

		<div class="banner-icons">
			<a href="#">▶</a> <a href="#">X</a> <a href="#">◎</a> <a href="#">f</a>
		</div>
	</div>
	
	<%@ include file="../Footer.jsp" %>
</body>
</html>