package cocacola.mvc.controller;

import java.io.IOException;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet("/cocacola/footer")
public class FooterServlet extends HttpServlet {

    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        String page = request.getParameter("page");
        String target = "";

        // page 파라미터가 없거나 빈 문자열이면 기본 페이지로 설정
        if (page == null || page.isEmpty()) {
            target = "/WEB-INF/views/cocacola/footer/sitemap.jsp";
        } else if ("sitemap".equals(page)) {
            target = "/WEB-INF/views/cocacola/footer/sitemap.jsp";
        } else if ("gogak".equals(page)) {
            target = "/WEB-INF/views/cocacola/footer/gogak.jsp";
        } else if ("terms_of_service".equals(page)) {
            target = "/WEB-INF/views/cocacola/footer/terms_of_service.jsp";
        } else if ("cookie_policy".equals(page)) {
            target = "/WEB-INF/views/cocacola/footer/cookie_policy.jsp";
        } else {
            // 알 수 없는 page 요청일 경우 404 처리
            response.sendError(HttpServletResponse.SC_NOT_FOUND);
            return;
        }

        request.getRequestDispatcher(target).forward(request, response);
    }
}
