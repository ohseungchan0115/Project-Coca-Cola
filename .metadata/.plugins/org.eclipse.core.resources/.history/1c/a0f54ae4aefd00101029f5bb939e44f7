package cocacola.mvc.persistence;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

import cocacola.mvc.domain.CreationStoryDTO;
import cocacola.mvc.domain.DetailDTO;
import cocacola.util.DBConn;

public class CreationDAOImpl implements CreationDAO {

    @Override
    public List<CreationStoryDTO> selectBySectionType(String sectionType) {

        List<CreationStoryDTO> list = new ArrayList<>();

        String sql =
            " SELECT story_id, section_type, title, summary, "
          + "        thumbnail_url, external_url "
          + " FROM creation_story "
          + " WHERE section_type = ? "
          + " ORDER BY display_order ";

        Connection conn = null;
        PreparedStatement pstmt = null;
        ResultSet rs = null;

        try {
            conn = DBConn.getConnection();
            pstmt = conn.prepareStatement(sql);
            pstmt.setString(1, sectionType);

            rs = pstmt.executeQuery();

            while (rs.next()) {
                CreationStoryDTO dto = new CreationStoryDTO();

                dto.setStoryId(rs.getInt("story_id"));
                dto.setSectionType(rs.getString("section_type"));
                dto.setTitle(rs.getString("title"));
                dto.setSummary(rs.getString("summary"));
                dto.setThumbnailUrl(rs.getString("thumbnail_url"));
                dto.setExternalUrl(rs.getString("external_url"));

                list.add(dto);
            }

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            try { if (rs != null) rs.close(); } catch (Exception e) {}
            try { if (pstmt != null) pstmt.close(); } catch (Exception e) {}
        }

        return list;
    }
    
    @Override
    public DetailDTO selectDetail(int id) {
        // DB 조회 후 DetailDTO 생성
        return null;
    }
}
