package cocacola.mvc.persistence;

import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.BeanPropertyRowMapper;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;
import cocacola.mvc.domain.OurCompanyDTO;

@Repository 
public class OurCompanyDAO {

    @Autowired 
    private JdbcTemplate jdbcTemplate;

    public List<OurCompanyDTO> selectAllContents() {
        String sql = "SELECT CONTENT_ID as contentId, SECTION_CODE as sectionCode, TITLE, SUMMARY, " +
                     "IMAGE_FILENAME as imageFilename, BUTTON_LINK as buttonLink, DISPLAY_ORDER as displayOrder " +
                     "FROM OURCOMPANY ORDER BY DISPLAY_ORDER ASC";

        return jdbcTemplate.query(sql, new BeanPropertyRowMapper<>(OurCompanyDTO.class));
    }
}