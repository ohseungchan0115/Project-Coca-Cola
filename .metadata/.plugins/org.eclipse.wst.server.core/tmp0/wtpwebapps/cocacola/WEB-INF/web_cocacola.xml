<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>jspPro</display-name>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.xhtml</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.xhtml</welcome-file>
  </welcome-file-list>
  
  <resource-ref>
    <description>Oracle Datasource example</description>
    <res-ref-name>jdbc/myoracle</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
    
  
    <filter>
  <description>인코딩필터</description>
  <filter-name>characterEncodingFilter</filter-name>
  <filter-class>com.filter.CharacterEncodingFilter</filter-class>
  <init-param>
     <description>인코딩 초기값</description>
     <param-name>encoding</param-name>
     <param-value>UTF-8</param-value>
  </init-param>
  </filter>
 <filter-mapping>
  <filter-name>characterEncodingFilter</filter-name> 
  <url-pattern>/*</url-pattern>
  <dispatcher>REQUEST</dispatcher>
 </filter-mapping>
 <servlet>
    <servlet-name>sustainability</servlet-name>
    <servlet-class>
        cocacola.mvc.controller.SustainabilityController
    </servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>sustainability</servlet-name>
    <url-pattern>/sustainability.do</url-pattern>
</servlet-mapping>
 
  
 <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>cocacola.mvc.controller.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>mappingPath</param-name>
            <param-value>/WEB-INF/cocacola_commandHandler.properties</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

</web-app>

