<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brand Story | 한국 코카-콜라</title>
<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/cocacola/css/BrandStory.css">
</head>

<body>
	<%@ include file="../nav.jsp"%>
	<div class="image--full-bleed">
		<img
			src="${pageContext.request.contextPath}/cocacola/brandstory/brand_story_banner.png"
			alt="Main Banner">
	</div>

	<div class="intro-text-box">
		<p>코카-콜라, 환타, 스프라이트 등 다양한 코카-콜라사 브랜드의 마케팅 캠페인, 모델 인터뷰, 비하인드 화보 등
			재미있고 흥미진진한 브랜드 스토리</p>
	</div>

	<!-- BrandStoryServlet에서 보낸 mainStories 리스트를 가져옴 -->
	<c:forEach var="story" items="${mainStories}" varStatus="status">
		<!-- 현재 인덱스를 2로 나눈 나머지가 0이 아니면 CSS에서 flex-direction을 반대로 뒤집어 이미지와 텍스트 위치를 바꾼 'reverse' 클래스를 추가 -->
		<div class="overlap-row ${status.index % 2 != 0 ? 'reverse' : ''}">
			<div class="card image-card">
				<!-- DB에 저장된 파일명을 절대경로로 출력 -->
				<img
					src="${pageContext.request.contextPath}/cocacola/brandstory/${story.image}"
					alt="${story.title}">
			</div>
			<div class="card text-card">
				<h3 class="title">${story.title}</h3>
				<p class="desc">${story.summary}</p>
				<!-- 클릭한 해당 게시글의 고유번호인 ID값을 서블릿에서 받아서 해당 스토리의 상세 JSP페이지로 연결 -->
				<a href="${pageContext.request.contextPath}/brandstory/detail.do?id=${story.id}">
    <button class="outline-btn">더 보기</button>
</a>
			</div>
		</div>
	</c:forEach>

	<h2 class="section-title">추천 콘텐츠</h2>
	<section class="recommend-section">
		<div class="carousel">
			<div class="carousel-track">
				<c:forEach var="story" items="${recommendStories}">
					<div class="carousel-card">
						<img
							src="${pageContext.request.contextPath}/cocacola/brandstory/${story.image}"
							alt="">
						<div class="card-body">
							<h3>${story.title}</h3>
							<p>${story.summary}</p>
						</div>
					</div>
				</c:forEach>
			</div>
		</div>
		<div class="carousel-dots">
			<c:forEach var="story" items="${recommendStories}" varStatus="s">
				<span class="dot ${s.first ? 'active' : ''}"></span>
			</c:forEach>
		</div>
	</section>

	<h2 class="section-title">더 많은 콘텐츠</h2>
	<section class="more-content-section">
		<c:forEach var="story" items="${moreStories}">
			<div class="more-item">
				<div class="more-text">
					<h3 class="title">${story.title}</h3>
					<p class="desc">${story.summary}</p>
					<button class="more-btn">더 보기</button>
				</div>
				<div class="more-thumb">
					<img
						src="${pageContext.request.contextPath}/cocacola/brandstory/${story.image}"
						alt="${story.title}">
				</div>
			</div>
		</c:forEach>
	</section>

	<%@ include file="../Footer.jsp"%>

	<script>
window.addEventListener('load', function() {
    const carousel = document.querySelector('.carousel');
    const track = document.querySelector('.carousel-track');
    const originalCards = track.querySelectorAll('.carousel-card');
    const dots = document.querySelectorAll('.carousel-dots .dot');

    if (originalCards.length === 0) return;

    const originalCount = originalCards.length;
    const cardGap = 24;

    // Clone for Loop
    originalCards.forEach(card => track.appendChild(card.cloneNode(true)));

    let isDragging = false;
    let startX = 0;
    let currentTranslate = 0;
    let prevTranslate = 0;

    const getMoveDistance = () => originalCards[0].offsetWidth + cardGap;

    carousel.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.pageX;
        track.style.transition = 'none';
        carousel.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const diff = e.pageX - startX;
        currentTranslate = prevTranslate + diff;
        track.style.transform = `translateX(\${currentTranslate}px)`;
    });

    window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        carousel.style.cursor = 'grab';

        const moveDistance = getMoveDistance();
        let currentIndex = Math.round(currentTranslate / -moveDistance);
        
        track.style.transition = 'transform 0.4s ease-out';
        currentTranslate = currentIndex * -moveDistance;
        prevTranslate = currentTranslate;
        track.style.transform = `translateX(\${currentTranslate}px)`;

        if (currentIndex >= originalCount) {
            setTimeout(() => {
                track.style.transition = 'none';
                currentTranslate = 0; prevTranslate = 0;
                track.style.transform = `translateX(0px)`;
                updateDots(0);
            }, 400);
        } else if (currentIndex < 0) {
            setTimeout(() => {
                track.style.transition = 'none';
                currentTranslate = (originalCount - 1) * -moveDistance;
                prevTranslate = currentTranslate;
                track.style.transform = `translateX(\${currentTranslate}px)`;
                updateDots(originalCount - 1);
            }, 400);
        }
        updateDots(currentIndex);
    });

    function updateDots(index) {
        let dotIndex = Math.abs(index) % originalCount;
        dots.forEach((dot, i) => dot.classList.toggle('active', i === dotIndex));
    }
});
</script>
</body>
</html>