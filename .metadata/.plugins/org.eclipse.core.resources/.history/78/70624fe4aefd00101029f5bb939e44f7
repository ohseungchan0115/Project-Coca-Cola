package cocacola.mvc.controller;

import java.io.IOException;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import cocacola.mvc.domain.CokeMealDTO;
import cocacola.mvc.persistence.CokeMealDAO;

@WebServlet("/cocacola/Discover1/coke_meal")
public class CokeMealServlet extends HttpServlet {
    protected void doGet(HttpServletRequest request, HttpServletResponse response) 
            throws ServletException, IOException {
        
    	// DB에 접근할 객체
        CokeMealDAO dao = new CokeMealDAO();
        List<CokeMealDTO> allStories = null;
		try {
			// DB에 저장된 모든 브랜드 스토리 데이터를 리스트 형태로 긁어오기
			allStories = dao.selectAll();
		} catch (SQLException e) {
			e.printStackTrace();
		}

        // 1. 상단 메인 엇갈린 카드 섹션용 (최신 데이터 2개)
        List<CokeMealDTO> cardStories1 = new ArrayList<>();
        // 2. 맛집 가이드 (그 다음 2개)
        List<CokeMealDTO> guide = new ArrayList<>();
        // 3. 상단 메인 엇갈린 카드 섹션용 (최신 데이터 3개)
        List<CokeMealDTO> cardStories2 = new ArrayList<>();
        List<CokeMealDTO> cardStories2_1 = new ArrayList<>();
        // 4. 콕지순례 (나머지 13개)
        List<CokeMealDTO> another = new ArrayList<>();

     // doGet 메서드 내부 루프

        if (allStories != null && !allStories.isEmpty()) {
            for (int i = 0; i < allStories.size(); i++) {
            	CokeMealDTO cokemeal = allStories.get(i);
                
                if (i <= 1) { 
                	cardStories1.add(cokemeal);
                } else if (i >= 2 && i <= 3) { 
                	guide.add(cokemeal);
                } else if (i >= 4 && i <= 5) { 
                	cardStories2.add(cokemeal);
                } else if (i == 6) { 
                	cardStories2_1.add(cokemeal);
                } else { 
                	another.add(cokemeal);
                }
            }
        }

        // JSP에서 쉽게 쓰도록 각각 데이터 저장
        request.setAttribute("cardStories1", cardStories1);
        request.setAttribute("guide", guide);
        request.setAttribute("cardStories2", cardStories2);
        request.setAttribute("cardStories2_1", cardStories2_1);
        request.setAttribute("another", another);

     // 화면 전환
     request.getRequestDispatcher("/WEB-INF/views/cocacola/Discover1/Coke_Meal.jsp").forward(request, response);

    
    }
}