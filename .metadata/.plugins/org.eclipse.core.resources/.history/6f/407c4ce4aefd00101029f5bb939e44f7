package cocacola.mvc.domain;

public class BrandVideoDTO {
    private int brandId;
    private String youtubeVideoId;
    private String videoThumbnailUrl;
    private String videoDescription;

    // getter/setter
    public int getBrandId() { return brandId; }
    public void setBrandId(int brandId) { this.brandId = brandId; }

    public String getYoutubeVideoId() { return youtubeVideoId; }
    public void setYoutubeVideoId(String youtubeVideoId) { this.youtubeVideoId = youtubeVideoId; }

    public String getVideoThumbnailUrl() { return videoThumbnailUrl; }
    public void setVideoThumbnailUrl(String videoThumbnailUrl) { this.videoThumbnailUrl = videoThumbnailUrl; }

    public String getVideoDescription() { return videoDescription; }
    public void setVideoDescription(String videoDescription) { this.videoDescription = videoDescription; }
}
