package cocacola.mvc.command;

import java.util.List;
import java.util.Map;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import cocacola.mvc.domain.CokeMealDTO;
import cocacola.mvc.service.CokeMealService;

public class CokeMealHandler implements CommandHandler {
    private CokeMealService service = new CokeMealService();

    @Override
    public String process(HttpServletRequest request, HttpServletResponse response) throws Exception {
        String idParam = request.getParameter("id");

        // 1. 상세 페이지 요청 처리
        if (idParam != null && !idParam.isEmpty()) {
            return "/WEB-INF/views/cocacola/Discover1/cokemealView_" + idParam + ".jsp";
        }

        // 2. 목록 페이지 데이터 처리 (id가 없을 때)
        Map<String, List<CokeMealDTO>> dataMap = service.getCokeMealLists();
        
        // JSP에서 사용하는 변수명 그대로 request에 저장
        dataMap.forEach((key, value) -> request.setAttribute(key, value));

        return "/WEB-INF/views/cocacola/Discover1/Coke_Meal.jsp";
    }
}