package cocacola.mvc.controller;

import java.io.IOException;
import java.util.List;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import cocacola.mvc.persistence.BrandDAO;
import cocacola.mvc.persistence.OurCompanyDAO;
import cocacola.mvc.domain.BrandDTO;
import cocacola.mvc.domain.OurCompanyDTO;

@WebServlet("/cocacola/OurCompany")
public class OurCompanyServlet extends HttpServlet {
    private static final long serialVersionUID = 1L;

    public OurCompanyServlet() {
        super();
    }

    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        // 1. 요청 페이지 파라미터 받기
        String page = request.getParameter("page");
        if (page == null) page = "main"; // 메인으로 기본값 변경 가능 (선택사항)
        
        OurCompanyDAO dao = new OurCompanyDAO();
        List<OurCompanyDTO> itemList = dao.selectAllContents();
        request.setAttribute("items", itemList);
        

        // ===== ⭐ nav용 Brand 데이터 추가 =====
        try {
            BrandDAO brandDAO = new BrandDAO();
            List<BrandDTO> mainBrands = brandDAO.selectBrandList();
            request.setAttribute("mainBrands", mainBrands);
        } catch (Exception e) {
            throw new ServletException(e);
        }

        
        
        // 2. 파라미터에 따른 JSP 이동 분기
        String targetJSP = "";
        if (page.equals("since")) {
            targetJSP = "/WEB-INF/views/cocacola/ourcompany/since_01.jsp";
        } else if (page.equals("main")) { // 메인 페이지 분기 추가
            targetJSP = "/WEB-INF/views/cocacola/ourcompany/main_01.jsp";
        } else {
            targetJSP = "/WEB-INF/views/cocacola/ourcompany/ourcompany_01.jsp";
        }
        
        request.getRequestDispatcher(targetJSP).forward(request, response);
    }

    protected void doPost(HttpServletRequest request
    		, HttpServletResponse response) throws ServletException, IOException {
        doGet(request, response);
    }
}