package cocacola.mvc.persistence;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

import cocacola.mvc.domain.OurCompanyDTO;

public class OurCompanyDAO {
    
    // 오라클 DB 연결 설정 
    private final String url = "jdbc:oracle:thin:@localhost:1521:xe";
    private final String user = "cola_user"; // 오라클 사용자명
    private final String password = "cola"; // 오라클 비밀번호

    // 생성자에서 드라이버 로드
    public OurCompanyDAO() {
        try {
            Class.forName("oracle.jdbc.driver.OracleDriver");
        } catch (ClassNotFoundException e) {
            e.printStackTrace();
        }
    }

    
    public List<OurCompanyDTO> selectAllContents() {
        List<OurCompanyDTO> list = new ArrayList<>();
        

        String sql = "SELECT CONTENT_ID, SECTION_CODE, TITLE, SUMMARY, IMAGE_FILENAME, BUTTON_LINK, DISPLAY_ORDER " +
                     "FROM OURCOMPANY ORDER BY DISPLAY_ORDER ASC";

        
        try (Connection conn = DriverManager.getConnection(url, user, password);
             PreparedStatement pstmt = conn.prepareStatement(sql);
             ResultSet rs = pstmt.executeQuery()) {

            while (rs.next()) {
                OurCompanyDTO dto = OurCompanyDTO.builder()
                        .contentId(rs.getInt("CONTENT_ID"))
                        .sectionCode(rs.getString("SECTION_CODE"))
                        .title(rs.getString("TITLE"))
                        .summary(rs.getString("SUMMARY"))
                        .imageFilename(rs.getString("IMAGE_FILENAME"))
                        .buttonLink(rs.getString("BUTTON_LINK"))
                        .displayOrder(rs.getInt("DISPLAY_ORDER"))
                        .build();
                
                list.add(dto);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        
        return list;
    }
}