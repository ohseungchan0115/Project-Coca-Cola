<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<!DOCTYPE html>
<html>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta charset="UTF-8">
<head>
    <title>Opener | Coca-Cola</title>

    <!-- CSS -->
    <link rel="stylesheet"
          href="${pageContext.request.contextPath}/cocacola/css/opener.css">
</head>
<body>

   <%@ include file="../nav.jsp" %> 

    <!-- HERO -->
    <main class="container responsivegrid">
        <div class="cmp-container">

            <div class="container responsivegrid container_content-start">
                <div class="cmp-container">

                     <!-- HERO -->
	                <div class="adaptiveImage image image--full-bleed opener-hero">
					  <picture class="loaded visible">
					    <img
					      src="${pageContext.request.contextPath}/cocacola/images/opener_hero.jpg"
					      alt="다양한 코카콜라 제품이 벽에 걸려있는 사진">
					  </picture>
					</div>
                </div>
            </div>

            <!-- INTRO -->
            <div class="container responsivegrid container_content">
			    <section class="opener-intro">
				  <div class="opener-intro__inner">
				    <p>
				      오프너(Opener)는 코카-콜라 스토리 플랫폼 코카-콜라 저니(Coca-Cola Journey)와 함께하는 크리에이터 모임입니다.
				      전 세계 200여 개국에서 판매하는 코카-콜라의 다양한 음료 브랜드를 소개하고 리뷰합니다.
				    </p>
				  </div>
				</section>
			</div>
        </div>
        
        <!-- ===============================
		     OPENER BUTTON AREA
		================================ -->
		<div class="container responsivegrid grid three-columns">
		  <div class="cmp-container">
		
		    <c:forEach var="c" items="${categoryList}">
		      <div class="button button--secondary">
		        <a class="cmp-button"
		           data-cmp-clickable=""
		            href="#cat-${c.categoryId}">
		          <span class="cmp-button__text">
		            ${c.categoryName}
		          </span>
		        </a>
		      </div>
		    </c:forEach>
		
		  </div>
		</div>


		
		<!-- ===============================
		     OPENER TITLE AREA
		================================ -->
		
		<c:forEach var="c" items="${categoryList}">
		  <c:if test="${c.categoryId == 1}">
		    <div class="title">
		      <div id="cat-${c.categoryId}" class="cmp-title">
		        <h2 class="cmp-title__text">
		          ${c.sectionTitle}
		        </h2>
		      </div>
		    </div>
		  </c:if>
		</c:forEach>



	
	   <!-- ===============================
		     OPENER CARD AREA
		================================ -->
		
		<c:forEach var="p" items="${postList}" begin="0" end="3">

		  <!-- LEFT CARD : 홀수 -->
		  <c:if test="${p.postId % 2 == 1}">
		    <div class="teaser campaign-card content-on-bottom content-on-left">
		      <div class="cmp-teaser">
		
		        <div class="cmp-teaser__content">
		          <div class="cmp-teaser__description">
		            <h3>${p.title}</h3>
		            <p>${p.summary}</p>
		          </div>
		
		          <div class="cmp-teaser__action-container">
		            <a class="cmp-teaser__action-link"
					   href="${pageContext.request.contextPath}${p.detailUrl}">
					   더 보기
					</a>
		          </div>
		        </div>
		
		        <div class="cmp-teaser__image">
		          <picture>
		            <img src="${pageContext.request.contextPath}${p.thumbnailUrl}"
		                 alt="오프너 이미지"
		                 class="cmp-image__image">
		          </picture>
		        </div>
				
		      </div>
		    </div>
		  </c:if>
		
		  <!-- RIGHT CARD : 짝수 -->
		  <c:if test="${p.postId % 2 == 0}">
		    <div class="teaser campaign-card content-on-bottom content-on-right">
		      <div class="cmp-teaser">
		
		        <div class="cmp-teaser__content">
		          <div class="cmp-teaser__description">
		            <h3>${p.title}</h3>
		            <p>${p.summary}</p>
		          </div>
		
		          <div class="cmp-teaser__action-container">
		            <a class="cmp-teaser__action-link"
		               href="${pageContext.request.contextPath}${p.detailUrl}">
		              더 보기
		            </a>
		          </div>
		        </div>
		
		        <div class="cmp-teaser__image">
		          <picture>
		            <img src="${pageContext.request.contextPath}${p.thumbnailUrl}"
		                 alt="오프너 이미지"
		                 class="cmp-image__image">
		          </picture>
		        </div>
		
		      </div>
		    </div>
		  </c:if>
		
		</c:forEach>

	
		<%-- two-column 배열 : POST_ID 5~8 --%>
		<div class="container responsivegrid grid two-columns">
		  <div class="cmp-container">
		
		    <c:forEach var="p" items="${postList}" begin="4" end="7">
		
		      <div class="teaser content-card">
		        <a href="${p.externalUrl}">
		          <div class="cmp-teaser">
		
		            <div class="cmp-teaser__content">
		              <h3 class="cmp-teaser__title">
		                ${p.title}
		              </h3>
		
		              <div class="cmp-teaser__description">
		                <p>${p.summary}</p>
		              </div>
		
		              <div class="cmp-teaser__action-container">
		                <p class="cmp-teaser__action-link">자세히 보기</p>
		              </div>
		            </div>
		
		            <div class="cmp-teaser__image">
		              <img src="${pageContext.request.contextPath}${p.thumbnailUrl}" alt="">
		            </div>
		
		          </div>
		        </a>
		      </div>
		
		    </c:forEach>
		
		  </div>
		</div>


		<!-- ===============================
		     OPENER TITLE AREA
		================================ -->
		
		<c:forEach var="c" items="${categoryList}">
		  <c:if test="${c.categoryId == 2}">
		    <div class="title">
		      <div id="cat-${c.categoryId}" class="cmp-title">
		        <h2 class="cmp-title__text">
		          ${c.sectionTitle}
		        </h2>
		      </div>
		    </div>
		  </c:if>
		</c:forEach>
		
		
		<!-- LEFT CARD -->
		

		<c:forEach var="p" items="${postList2}">
		  <c:if test="${p.postId == 9}">
		
		    <div class="teaser campaign-card content-on-bottom content-on-left">
		      <div class="cmp-teaser">
		
		        <div class="cmp-teaser__content">
		          <div class="cmp-teaser__description">
		            <h3>
		              ${fn:replace(p.title, '! ', '!<br>')}
		            </h3>
		            <p>
		              ${p.summary}
		            </p>
		          </div>
		
		          <div class="cmp-teaser__action-container">
		            <a class="cmp-teaser__action-link"
		               href="${p.externalUrl}">
		              더 보기
		            </a>
		          </div>
		        </div>
		
		        <div class="cmp-teaser__image">
		          <picture>
		            <img src="${pageContext.request.contextPath}${p.thumbnailUrl}"
		                 alt="오프너 이미지"
		                 class="cmp-image__image">
		          </picture>
		        </div>
		
		      </div>
		    </div>
		
		  </c:if>
		</c:forEach>

		        
		<%-- three-column 배열 --%>
		<div class="container responsivegrid grid three-columns">
		  <div class="cmp-container">
		
		    <c:forEach var="p" items="${postList2}" begin="1" end="3">
		
		      <div class="teaser content-card">
		        <a href="${p.externalUrl}">
		          <div class="cmp-teaser">
		
		            <div class="cmp-teaser__content">
		              <h3 class="cmp-teaser__title">
		                ${p.title}
		              </h3>
		
		              <div class="cmp-teaser__description">
		                <p>
		                  ${p.summary}
		                </p>
		              </div>
		
		              <div class="cmp-teaser__action-container">
		                <p class="cmp-teaser__action-link">더 보기</p>
		              </div>
		            </div>
		
		            <div class="cmp-teaser__image">
		              <img src="${pageContext.request.contextPath}${p.thumbnailUrl}" alt="">
		            </div>
		
		          </div>
		        </a>
		      </div>
		
		    </c:forEach>
		
		  </div>
		</div>

			     
		<!-- ===============================
		     OPENER TITLE AREA
		================================ -->	     
	 	<c:forEach var="c" items="${categoryList}">
		  <c:if test="${c.categoryId == 3}">
		    <div class="title">
		      <div id="cat-${c.categoryId}" class="cmp-title">
		        <h2 class="cmp-title__text">
		          ${c.sectionTitle}
		        </h2>
		      </div>
		    </div>
		  </c:if>
		</c:forEach>

		
		<!-- ===============================
		     OPENER LIST-ITEM AREA
		================================ -->
		<c:forEach var="p" items="${postList3}">
		  <div class="teaser list-item">		
		
		    <!-- 텍스트 영역 -->
		    <div class="list-item__content">
		      <h3 class="list-item__title">
		        ${p.title}
		      </h3>
		
		      <p class="list-item__description">
		        ${p.summary}
		      </p>
		
		      <div class="cmp-teaser__action-container">
		        <a class="cmp-teaser__action-link"
		           href="${p.externalUrl}">
		          더 보기
		        </a>
		      </div>
		    </div>
		
		    <!-- 이미지 영역 -->
		    <div class="list-item__image">
		      <img
		        src="${pageContext.request.contextPath}${p.thumbnailUrl}"
		        alt="${p.title}">
		    </div>
		
		  </div>
		</c:forEach>

    </main>
    
	<%@ include file="../Footer.jsp" %> 
	
</body>
</html>
