package cocacola.mvc.domain;

public class CategoryDTO {
    private int brandCategoryId;
    private String brandCategoryName;
    private String brandCategoryDescription;

    // getter/setter
    public int getBrandCategoryId() { return brandCategoryId; }
    public void setBrandCategoryId(int brandCategoryId) { this.brandCategoryId = brandCategoryId; }

    public String getBrandCategoryName() { return brandCategoryName; }
    public void setBrandCategoryName(String brandCategoryName) { this.brandCategoryName = brandCategoryName; }

    public String getBrandCategoryDescription() { return brandCategoryDescription; }
    public void setBrandCategoryDescription(String brandCategoryDescription) { this.brandCategoryDescription = brandCategoryDescription; }
}
