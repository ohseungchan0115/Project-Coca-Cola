<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<c:set var="cp" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<style>
/* [1. 공통 및 레이아웃 설정] */
:root { 
	--color-bg: #f2f2f2;
}

* {
	box-sizing: border-box;
}

body, html {
	margin: 0;
	padding: 0;
	background-color: var(--color-bg);
	font-family: sans-serif;
}

/* [3. 상단 슬라이더 섹션] */
.slider-section {
	max-width: 1350px;
	margin: 50px auto 30px;
	position: relative;
	overflow: hidden;
}

.mySwiper {
	width: 100%;
	height: 570px;
	overflow: visible !important;
}

.mySwiper .swiper-slide {
	width: 1100px !important;
	flex-shrink: 0 !important;
	border-radius: 40px;
	overflow: hidden;
}

.mySwiper .swiper-slide img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	opacity: 0.5; /* 상단 슬라이더는 비활성 슬라이드 투명도 유지 */
	transition: opacity 0.4s ease;
}

.mySwiper .swiper-slide-active img, .mySwiper .swiper-slide-duplicate-active img
	{
	opacity: 1 !important;
}

/* [4. 상단 인디케이터 - 점 7개 전용] */
.dots-container {
	width: 100%;
	display: flex;
	justify-content: center;
	padding: 20px 0 60px;
}

.my-pagination.swiper-pagination {
	position: relative !important;
	bottom: 0 !important;
}

.my-pagination .swiper-pagination-bullet {
	width: 10px !important;
	height: 10px !important;
	background: #ccc !important;
	opacity: 1 !important;
	margin: 0 8px !important;
	cursor: pointer;
}

.my-pagination .swiper-pagination-bullet-active {
	width: 30px !important;
	background: #000 !important;
	border-radius: 10px !important;
	transition: width 0.3s;
}

/* [5. 하단 이달의 PICK 섹션] */
.content-inner {
	max-width: 1040px;
	margin: 60px auto 60px;
}

.section-title {
	font-size: 1.8rem;
	font-weight: 800;
	margin-bottom: 40px;
	text-align: center;
}

.pickSwiper {
	width: 100%;
	padding-bottom: 60px !important;
	overflow: hidden !important;
}

/* 하단 슬라이더는 모든 슬라이드가 투명도 없이 선명하게 보임 */
.pickSwiper .swiper-slide {
	width: 326.66px !important;
	opacity: 1 !important;
	height: auto;
}

.pick-card {
	background: #fff;
	border-radius: 30px;
	overflow: hidden;
	box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
	height: 100%;
	display: flex;
	flex-direction: column;
}

.pick-card img {
	width: 100%;
	height: 240px;
	object-fit: cover;
	opacity: 1 !important; /* 선명도 고정 */
}

.pick-card-body {
	padding: 25px;
	min-height: 160px;
	flex-grow: 1;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

.pick-card-body h3 {
	font-size: 1.1rem;
	font-weight: 700;
	margin: 0;
	line-height: 1.5;
	word-break: keep-all;
}

.more-link {
	align-self: flex-end;
	display: inline-flex;
	align-items: center;
	color: #333;
	font-size: 0.9rem;
	font-weight: 700;
	text-decoration: none;
	margin-top: 20px;
}

.more-link::after {
	content: '→';
	margin-left: 8px;
	font-size: 1.1rem;
}

/* [6. 하단 인디케이터 - 점 3개 전용] */
.pick-pagination.swiper-pagination {
	position: relative !important;
	bottom: 0 !important;
	margin-top: 30px;
	display: flex;
	justify-content: center;
	align-items: center;
}

.pick-pagination .swiper-pagination-bullet {
	width: 10px;
	height: 10px;
	background: #ccc;
	opacity: 1;
	margin: 0 6px !important;
}

.pick-pagination .swiper-pagination-bullet-active {
	width: 30px;
	background: #000;
	border-radius: 10px;
	transition: width 0.3s;
}

/* [7. 하단 Journey 섹션 스타일 - 테두리 제거 및 패딩 조정] */
.journey-section {
	max-width: 1040px;
	margin: 0 auto 100px;
}

.journey-container {
	background-color: #fff;
	/* border: 2px solid #2b72da; <-- 테두리 제거됨 */
	border-radius: 20px;
	padding: 30px 40px; /* 상하좌우 패딩 10px씩 감소 */
	box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
}

.journey-content h2 {
	font-size: 1.4rem;
	font-weight: 800;
	color: #000;
	margin: 0 0 15px 0;
}

.journey-content p {
	font-size: 0.95rem;
	color: #333;
	line-height: 1.6;
	margin-bottom: 30px;
}

.journey-btn {
	display: inline-block;
	padding: 12px 45px;
	border: 1px solid #000;
	border-radius: 30px;
	text-decoration: none;
	color: #000;
	font-size: 0.9rem;
	font-weight: 700;
	transition: all 0.3s ease;
}

.journey-btn:hover {
	background-color: #000;
	color: #fff;
}

/* [8. 추가 카드 섹션 스타일 - 최종 미세 조정 버전] */
.company-card-section {
	max-width: 1400px;
	margin: 150px auto 100px;
	padding: 0 40px;
}

.intro-block {
	display: flex;
	align-items: center;
	justify-content: center;
	/* 11번과 12번 카드 사이의 여백을 더 확실하게 부여 */
	margin-bottom: 200px;
	position: relative;
}

/* 흰색 텍스트 박스: 파란색 박스 높이를 줄이기 위해 top 값을 -40px로 수정 */
.intro-block .text-content {
	flex: none;
	width: 550px;
	height: 550px;
	padding: 120px 60px; /* 내부 여백 살짝 조정 */
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	background-color: #fff;
	border-radius: 10px;
	box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
	z-index: 10;
	position: relative;
	top: -40px; /* 수치를 줄여서 이미지와의 높이 차이를 좁힘 */
}

/* 이미지 컨테이너: 아래로 내려가는 수치도 동일하게 40px로 조정 */
.intro-block .image-content {
	flex: none;
	width: 600px;
	height: 550px;
	overflow: hidden;
	border-radius: 10px;
	position: relative;
	top: 40px; /* 수치를 줄여서 안정감 있게 배치 */
}

.intro-block .image-content img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}

/* 가로 겹침 및 지그재그 설정 유지 */
.intro-block.default-order .text-content {
	margin-right: -100px;
}

.intro-block.reverse-order {
	flex-direction: row-reverse;
}

.intro-block.reverse-order .text-content {
	margin-left: -100px;
}

/* 텍스트 내부 여백 보정 */
.intro-block .text-content h2 {
	font-size: 2.2rem;
	font-weight: 700;
	margin-top: -30px; /* 높이차 감소에 따른 상단 마진 보정 */
	margin-bottom: 20px;
	color: #222;
}

.intro-block .text-content p {
	font-size: 1rem;
	line-height: 1.8;
	color: #555;
	margin-bottom: auto;
}

/* 버튼 스타일 유지 */
.intro-block .intro-button {
	display: inline-block;
	min-width: 300px;
	text-align: center;
	padding: 10px 30px;
	border: 2px solid #000;
	border-radius: 50px;
	text-decoration: none;
	color: #000;
	font-weight: bold;
	transition: all 0.3s;
	margin-bottom: -40px; /* 높이차와 동일하게 맞춤 */
}

.intro-block .intro-button:hover {
	background-color: #f0f0f0;
}

/* [9. 브랜드 살펴보기 섹션 스타일] */
.brand-lookup-section {
	max-width: 800px;
	margin: 10px auto 100px;
	padding: 0 20px;
	text-align: center;
}

.brand-lookup-section .section-title {
	font-size: 2rem;
	font-weight: 800;
	margin-bottom: 50px;
	color: #000;
}

/* 3열 그리드 레이아웃 */
.brand-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 25px;
	margin-bottom: 50px;
}

.brand-item {
	background-color: #fff;
	border-radius: 20px;
	height: 220px;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
	transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.brand-item:hover {
	transform: translateY(-5px);
	box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

.brand-item img {
	max-width: 70%;
	max-height: 60%;
	object-fit: contain;
}

/* 모두 보기 버튼 스타일 */
.view-all-area {
	display: flex;
	justify-content: center;
}

.view-all-button {
	display: inline-block;
	width: 350px;
	padding: 12px 0;
	background-color: #f2f2f2;
	border: 1.5px solid #000;
	border-radius: 50px;
	text-decoration: none;
	color: #000;
	font-weight: 700;
	font-size: 0.95rem;
	transition: all 0.3s;
}

.view-all-button:hover {
	background-color: #e5e5e5;
}
</style>
</head>
<body>
	<%-- 네비게이션 포함 (절대 수정 금지된 nav.jsp 기준) --%>
	<%@ include file="../nav.jsp"%>

	<main>
		<%-- [1] 상단 키이미지 슬라이더 섹션 --%>
		<section class="slider-section">
			<div class="swiper mySwiper">
				<div class="swiper-wrapper">
					<c:forEach var="i" begin="1" end="7">
						<div class="swiper-slide">
							<%-- nav.jsp 로고 경로 형식에 맞춰 /cocacola를 수동 추가 --%>
							<img
								src="${pageContext.request.contextPath}/cocacola/OurCompany_images/main_0${i}.png">
						</div>
					</c:forEach>
				</div>
			</div>
			<div class="dots-container">
				<div class="swiper-pagination my-pagination"></div>
			</div>
		</section>

		<%-- [2] 이달의 PICK 섹션: 중복 제거 및 단일 출력 --%>
		<section class="content-inner">
			<h2 class="section-title">이달의 PICK</h2>
			<div class="swiper pickSwiper">
				<div class="swiper-wrapper">
					<%-- 이미 출력된 파일명을 저장할 변수 (중복 체크용) --%>
					<c:set var="renderedFiles" value="" />
					<%-- 출력된 카드의 개수를 세기 위한 변수 --%>
					<c:set var="pickCount" value="0" />

					<c:forEach var="dto" items="${items}">
						<%-- MAIN 섹션이면서 출력 개수가 3개 미만일 때만 실행 --%>
						<c:if test="${dto.sectionCode == 'MAIN' && pickCount < 3}">
							<c:set var="num"
								value="${fn:substringAfter(fn:substringBefore(dto.imageFilename, '.'), 'main_')}" />

							<%-- 8, 9, 10번 이미지이고, 아직 출력되지 않은 파일명인 경우에만 출력 --%>
							<c:if
								test="${num >= 8 && num <= 10 && !fn:contains(renderedFiles, dto.imageFilename)}">
								<div class="swiper-slide">
									<div class="pick-card">
										<%-- nav.jsp 기준에 맞춘 경로 --%>
										<img
											src="${pageContext.request.contextPath}/cocacola/OurCompany_images/${dto.imageFilename}">
										<div class="pick-card-body">
											<h3>${dto.title}</h3>
											<a href="#" class="more-link">더보기</a>
										</div>
									</div>
								</div>
								<%-- 출력된 파일명을 기록하고 카운트 증가 --%>
								<c:set var="renderedFiles"
									value="${renderedFiles},${dto.imageFilename}" />
								<c:set var="pickCount" value="${pickCount + 1}" />
							</c:if>
						</c:if>
					</c:forEach>
				</div>
				<div class="swiper-pagination pick-pagination"></div>
			</div>
		</section>

		<%-- [3] Journey 섹션 --%>
		<section class="journey-section">
			<div class="journey-container">
				<div class="journey-content">
					<h2>Coca-Cola Journey : 코카-콜라 이야기 속으로 떠나는 여정</h2>
					<p>
						코카-콜라 오리지널 콘텐츠 시리즈 &lt;썰스티&gt; 공개!<br>오늘의 음료를 둘러싼 다양하고 재미있는
						'썰'을 만나보세요.
					</p>
					<a
						href="${pageContext.request.contextPath}/cocacola/Discover1/originals"
						class="journey-btn">자세히 보러 가기</a>
				</div>
			</div>
		</section>

		<%-- [4] 회사 소개 카드 섹션: 중복 제거 및 단일 출력 --%>
		<section class="company-card-section">
			<%-- 중복 방지를 위해 이미 출력했는지 체크하는 변수 설정 --%>
			<c:set var="isIntro11Done" value="false" />
			<c:set var="isIntro12Done" value="false" />

			<c:forEach var="dto" items="${items}">
				<c:if test="${dto.sectionCode == 'MAIN'}">
					<c:set var="num"
						value="${fn:substringAfter(fn:substringBefore(dto.imageFilename, '.'), 'main_')}" />

					<%-- 11번 이미지 (Real Magic 스토리) - 한 번만 출력 --%>
					<c:if test="${num == '11' && !isIntro11Done}">
						<div class="intro-block default-order">
							<div class="text-content">
								<h2>${dto.title}</h2>
								<p>${dto.summary}</p>
								<a
									href="${pageContext.request.contextPath}/cocacola/OurCompany?page=company"
									class="intro-button">자세히 보기</a>
							</div>
							<div class="image-content">
								<img
									src="${pageContext.request.contextPath}/cocacola/OurCompany_images/${dto.imageFilename}">
							</div>
						</div>
						<c:set var="isIntro11Done" value="true" />
					</c:if>

					<%-- 12번 이미지 (지속 가능한 미래) - 한 번만 출력 --%>
					<c:if test="${num == '12' && !isIntro12Done}">
						<div class="intro-block reverse-order">
							<div class="text-content">
								<h2>${dto.title}</h2>
								<p>${dto.summary}</p>
								<a href="${dto.buttonLink}" class="intro-button">자세히 보기</a>
							</div>
							<div class="image-content">
								<img
									src="${pageContext.request.contextPath}/cocacola/OurCompany_images/${dto.imageFilename}">
							</div>
						</div>
						<c:set var="isIntro12Done" value="true" />
					</c:if>
				</c:if>
			</c:forEach>
		</section>

		<%-- [5] 브랜드 그리드 섹션 --%>
		<section class="brand-lookup-section">
			<h2 class="section-title">브랜드 살펴보기</h2>
			<div class="brand-grid">
				<c:forEach var="b" items="${mainBrands}" varStatus="status">
					<c:if test="${status.index < 6}">
						<a
							href="${pageContext.request.contextPath}/cocacola/brands/brandDetail?brandId=${b.brandId}">
							<div class="brand-item">
								<%-- nav.jsp 형식에 따라 /cocacola/images/ 로 수정 --%>
								<img
									src="${pageContext.request.contextPath}/cocacola/images/${b.brandLogoUrl}"
									alt="${b.brandName}" />
							</div>
						</a>
					</c:if>
				</c:forEach>
			</div>
			<div class="view-all-area">
				<a href="${pageContext.request.contextPath}/cocacola/brands"
					class="view-all-button">모두 보기</a>
			</div>
		</section>
	</main>

	<%@ include file="../Footer.jsp"%>
	<script
		src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
	<script>
const swiper = new Swiper(".mySwiper", {
    slidesPerView: "auto",
    centeredSlides: true,
    spaceBetween: 20,
    loop: true,
    initialSlide: 0, 
    loopedSlides: 7, 
    pagination: { el: ".my-pagination", clickable: true },
    speed: 600,
    watchSlidesProgress: true,
    normalizeSlideIndex: true,
});

(function() {
    const pickWrapper = document.querySelector('.pickSwiper .swiper-wrapper');
    const pickSlides = pickWrapper.querySelectorAll('.swiper-slide');
    if (pickSlides.length === 3) {
        for(let j=0; j<2; j++) {
            pickSlides.forEach(slide => {
                const clone = slide.cloneNode(true);
                pickWrapper.appendChild(clone);
            });
        }
    }
    const pickSwiper = new Swiper(".pickSwiper", {
        slidesPerView: 3,
        spaceBetween: 30,
        loop: true,
        slidesPerGroup: 1,
        pagination: {
            el: ".pick-pagination",
            clickable: true,
            renderBullet: function (index, className) {
                if (index < 3) return '<span class="' + className + '"></span>';
                return '';
            },
        },
        speed: 600,
        observer: true,
        observeParents: true,
        watchSlidesProgress: true,
    });
})();
</script>
</body>
</html>